{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "ebank-ui": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/ebank-ui",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "assets": ["src/favicon.svg"],
            "styles": ["src/styles.css"],
            "scripts": []
          },
          "configurations": {
            "production": {"outputHashing": "all", "budgets": [{"type": "initial", "maximumWarning": "850kb", "maximumError": "2mb"}]},
            "development": {"optimization": false, "sourceMap": true}
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {"buildTarget": "ebank-ui:build:production"},
            "development": {"buildTarget": "ebank-ui:build:development"}
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
